{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "palimpsest",
  "version": "0.2.1",
  "identifier": "dev.palimpsest.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Palimpsest",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "palimpsest.desktop"
      },
      "rpm": {
        "desktopTemplate": "palimpsest.desktop"
      }
    }
  }
}
