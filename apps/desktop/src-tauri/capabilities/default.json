{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-rename",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    { "identifier": "fs:scope", "allow": [
      { "path": "$APPDATA/**" },
      { "path": "$APPDATA/dev.palimpsest.app/palimpsest-demo/.palimpsest/**" },
      { "path": "$APPCONFIG/**" }
    ] },
    "dialog:default"
  ]
}
